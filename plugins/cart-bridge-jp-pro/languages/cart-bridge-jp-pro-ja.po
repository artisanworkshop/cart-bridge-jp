#: includes/Admin/PasswordEmailPage.php:387
#, php-format
msgid "Left out: %s"
msgstr "対象外（%s）"

#. translators: %s: the number of customers.
#: includes/Admin/PasswordEmailPage.php:399
#, php-format
msgid "Sending to %s customer was interrupted, so it is unknown whether the email reached them. They are left out until you mark them as not sent."
msgid_plural "Sending to %s customers was interrupted, so it is unknown whether the email reached them. They are left out until you mark them as not sent."
msgstr[0] "%s 人の顧客への送信が途中で止まったため、メールが届いたかが分かりません。未送信に戻すまで、この顧客には送りません。"

#: includes/Admin/PasswordEmailPage.php:422
msgid "Accounts imported by version 0.1.0 could not be identified reliably, so they are left out."
msgstr "バージョン 0.1.0 で取り込んだアカウントを確実に見分けられなかったため、対象から外しました。"

#: includes/Admin/PasswordEmailPage.php:430
msgid "Accounts likely imported by version 0.1.0"
msgstr "バージョン 0.1.0 で取り込んだと思われるアカウント"

#: includes/Admin/PasswordEmailPage.php:431
msgid "Version 0.1.0 did not mark the accounts it created. These accounts were registered while a customer import of version 0.1.0 was running, so they were most likely created by it. They receive the email only if you include them when you start sending. Whether they have already set a password cannot be told."
msgstr "バージョン 0.1.0 は、作ったアカウントに印を付けませんでした。次のアカウントは、バージョン 0.1.0 の顧客のインポートの実行中に登録されたため、そのインポートが作った可能性が高いアカウントです。送信を始めるときに含めた場合だけ、メールを送ります。パスワードを設定し直したかは判定できません。"

#: includes/Admin/PasswordEmailPage.php:434
msgid "Name"
msgstr "名前"

#: includes/Admin/PasswordEmailPage.php:434
msgid "Email"
msgstr "メールアドレス"

#: includes/Admin/PasswordEmailPage.php:434
msgid "Registered"
msgstr "登録日時"

