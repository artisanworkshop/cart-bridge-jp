#: includes/Admin/PasswordEmailPage.php:457
#, php-format
msgid "And %s more."
msgstr "ほか %s 件。"

#: includes/Admin/PasswordEmailPage.php:470
#: includes/Admin/PasswordEmailPage.php:473
msgid "Send a test email"
msgstr "テストメールを送る"

#: includes/Admin/PasswordEmailPage.php:471
msgid "Sends the email to your own address with a sample name and a sample link, so that you can check the text and the design."
msgstr "見本の名前とリンクで、あなたのアドレスにメールを送ります。文面とデザインを確認できます。"

#: includes/Admin/PasswordEmailPage.php:478
msgid "Resume sending"
msgstr "送信を再開"

#: includes/Admin/PasswordEmailPage.php:480
msgid "Resume"
msgstr "再開"

#: includes/Admin/PasswordEmailPage.php:484
#: includes/Admin/PasswordEmailPage.php:487
msgid "Cancel sending"
msgstr "送信を取り消す"

#: includes/Admin/PasswordEmailPage.php:485
msgid "Stops sending to the remaining customers. Emails already sent cannot be recalled."
msgstr "残りの顧客への送信を止めます。送ったメールは取り消せません。"

#: includes/Admin/PasswordEmailPage.php:492
msgid "Mark interrupted emails as not sent"
msgstr "途中で止まったメールを未送信に戻す"

#: includes/Admin/PasswordEmailPage.php:493
msgid "These customers receive the email in the next sending. Some of them may receive it twice."
msgstr "この顧客には次の送信でメールを送ります。2 通届く顧客がいるかもしれません。"

#: includes/Admin/PasswordEmailPage.php:495
msgid "Mark as not sent"
msgstr "未送信に戻す"

#: includes/Admin/PasswordEmailPage.php:503
msgid "Send to customers"
msgstr "顧客へ送る"

#: includes/Admin/PasswordEmailPage.php:524
msgid "This site is not marked as a production site (for example, a staging copy). Send the emails from this site anyway. Customers will receive links to this site."
msgstr "このサイトは本番のサイトとして設定されていません（ステージングの複製など）。それでもこのサイトからメールを送ります。顧客にはこのサイトへのリンクが届きます。"

#: includes/Admin/PasswordEmailPage.php:542
msgid "Start sending"
msgstr "送信を開始"

#: includes/Admin/PasswordEmailPage.php:547
msgid "Before sending"
msgstr "送る前に"

#: includes/Admin/PasswordEmailPage.php:551
msgid "Many hosting services limit how many emails a site can send per hour. Use an SMTP plugin or an email delivery service, and send a test email first. The emails are sent in small batches, and sending stops if several emails in a row cannot be sent."
msgstr "多くのレンタルサーバーは、1 時間に送れるメールの数を制限しています。SMTP のプラグインかメール配信サービスを使い、先にテストメールを送ってください。メールは少しずつ送り、続けて何通か送れなかったときは送信を止めます。"

#: includes/Admin/PasswordEmailPage.php:552
msgid "The subject, heading, and additional text can be changed in the WooCommerce email settings. Do not add advertisements to this email."
msgstr "件名・見出し・追加の文は、WooCommerce のメールの設定で変えられます。このメールに広告を入れないでください。"

#. translators: %s: how long the link works, such as "1 day".
#: includes/Admin/PasswordEmailPage.php:554
#, php-format
msgid "The link in the email works for %s. Customers can request a new link from the lost password page, which the email also shows."
msgstr "メールのリンクの有効期限は %s です。期限が切れたら、顧客はパスワードを忘れた場合のページから新しいリンクを受け取れます（このページもメールに載せます）。"

#: includes/Admin/PasswordEmailPage.php:555
msgid "Creating the link updates each customer account, so other plugins that watch account changes may react to it."
msgstr "リンクを作ると各顧客のアカウントが更新されるため、アカウントの変更を監視する他のプラグインが反応する場合があります。"

#: includes/Admin/PasswordEmailPage.php:556
msgid "The email goes to the address stored in each account. If the previous shop did not verify email addresses, an address may belong to someone else."
msgstr "メールは各アカウントに保存されたアドレスに送ります。前のショップがメールアドレスを確認していなかった場合、別の人のアドレスの可能性があります。"

#: includes/Admin/PasswordEmailPage.php:557
msgid "Only accounts created by the import receive the email. Accounts that already existed and were matched by email, and staff accounts, are left out."
msgstr "メールを送るのは、インポートが作ったアカウントだけです。メールアドレスの一致で結び付けた既存のアカウントとスタッフのアカウントには送りません。"

#: includes/Admin/PasswordEmailPage.php:568
msgid "Edit the email in the WooCommerce settings"
msgstr "WooCommerce の設定でメールを編集"

#: includes/Admin/PasswordEmailPage.php:597
msgid "The password setup email is disabled. Enable it in the WooCommerce email settings."
msgstr "パスワード設定メールが無効です。WooCommerce のメールの設定で有効にしてください。"

#: includes/Admin/PasswordEmailPage.php:598
msgid "The link in the email needs the My account page and its lost password endpoint. Publish the My account page and set the endpoint in the WooCommerce settings."
msgstr "メールのリンクには、マイアカウントのページとパスワード紛失のエンドポイントが必要です。マイアカウントのページを公開し、WooCommerce の設定でエンドポイントを設定してください。"

#: includes/Admin/PasswordEmailPage.php:599
msgid "Several emails in a row could not be sent. Check the email settings of this site, such as an SMTP plugin or the sending limit of your hosting, and then resume."
msgstr "続けて何通か送れませんでした。このサイトのメールの設定（SMTP のプラグインやレンタルサーバーの送信数の上限など）を確認してから再開してください。"

#: includes/Admin/PasswordEmailPage.php:601
msgid "The background task could not be scheduled. Try again."
msgstr "バックグラウンドの処理を予約できませんでした。もう一度試してください。"

#: includes/Admin/PasswordEmailPage.php:603
msgid "The sending state changed unexpectedly. Check the status and start again if needed."
msgstr "送信の状態が思いがけず変わりました。状態を確認し、必要ならもう一度始めてください。"

#: includes/Admin/PasswordEmailPage.php:608
msgid "Sending to customers requires an activated license key. Activate it on the License tab."
msgstr "顧客へ送るには、有効化したライセンスキーが必要です。「ライセンス」タブで有効化してください。"

#: includes/PasswordEmail/PasswordSetupEmail.php:38
msgid "Password setup after store migration"
msgstr "ストア移転後のパスワード設定"

#: includes/PasswordEmail/PasswordSetupEmail.php:39
msgid "Sent from WooCommerce > Cart Bridge JP Pro > Password setup emails to customers whose accounts were created by importing them from another shop. The email asks them to set a password for this store."
msgstr "WooCommerce > Cart Bridge JP Pro > パスワード設定メール から、別のショップから取り込んで作ったアカウントの顧客へ送ります。このストアのパスワードを設定するよう案内します。"

#: includes/PasswordEmail/PasswordSetupEmail.php:108
msgid "Set a password for your account at {site_title}"
msgstr "{site_title} のアカウントのパスワードを設定してください"

#: includes/PasswordEmail/PasswordSetupEmail.php:115
msgid "Our store has moved"
msgstr "ストアを移転しました"

#: includes/PasswordEmail/PasswordSetupEmail.php:229
msgid "Sample Customer"
msgstr "山田 太郎"

#. translators: %s: the customer name.
#: templates/emails/cbjp-pro-password-setup.php:26
#: templates/emails/plain/cbjp-pro-password-setup.php:25
#, php-format
msgid "Hi %s,"
msgstr "%s 様"

#: templates/emails/cbjp-pro-password-setup.php:27
#: templates/emails/plain/cbjp-pro-password-setup.php:27
msgid "Our online store has moved to a new website:"
msgstr "オンラインストアは新しいサイトへ移転しました："

#: templates/emails/cbjp-pro-password-setup.php:28
#: templates/emails/plain/cbjp-pro-password-setup.php:29
msgid "Your customer account has been moved to the new store, but your password could not be moved. To sign in, set a new password using the link below."
msgstr "お客様のアカウントは新しいストアへ移しましたが、パスワードは移せませんでした。ログインするには、下のリンクから新しいパスワードを設定してください。"

#: templates/emails/cbjp-pro-password-setup.php:29
msgid "Set your password"
msgstr "パスワードを設定する"

#. translators: %s: how long the link works, such as "1 day".
#: templates/emails/cbjp-pro-password-setup.php:31
#: templates/emails/plain/cbjp-pro-password-setup.php:32
#, php-format
msgid "This link expires in %s."
msgstr "このリンクの有効期限は %s です。"

#: templates/emails/cbjp-pro-password-setup.php:32
#: templates/emails/plain/cbjp-pro-password-setup.php:33
msgid "If the link has expired, you can request a new one on this page:"
msgstr "期限が切れた場合は、次のページから新しいリンクを受け取れます："

#. translators: %s: the number of customers.
#: includes/Admin/PasswordEmailPage.php:357
#, php-format
msgid "%s of them was imported by an earlier version, so whether they have already set a password cannot be told. They receive the email."
msgid_plural "%s of them were imported by an earlier version, so whether they have already set a password cannot be told. They receive the email."
msgstr[0] "このうち %s 人は以前の版で取り込んだため、パスワードを設定し直したかを判定できません。この顧客にも送ります。"

#. translators: 1: the address of this site, 2: the number of customers.
#: includes/Admin/PasswordEmailPage.php:513
#, php-format
msgid "The store has moved to this site (%1$s). Send the email to %2$s customer."
msgid_plural "The store has moved to this site (%1$s). Send the email to %2$s customers."
msgstr[0] "ストアはこのサイト（%1$s）へ移りました。%2$s 人の顧客にメールを送ります。"

#. translators: %s: the number of accounts.
#: includes/Admin/PasswordEmailPage.php:535
#, php-format
msgid "Also send to the %s account likely imported by version 0.1.0 (listed above)."
msgid_plural "Also send to the %s accounts likely imported by version 0.1.0 (listed above)."
msgstr[0] "バージョン 0.1.0 で取り込んだと思われる %s 件のアカウント（上の一覧）にも送る。"

#: includes/Admin/PasswordEmailPage.php:600
msgid "The send records could not be saved on this site, so sending stopped to avoid sending anyone the email twice. Check the database and any plugin that changes how user data is saved, and then resume."
msgstr "このサイトに送信の記録を保存できなかったため、同じ顧客に 2 通送らないよう送信を止めました。データベースと、ユーザーのデータの保存を変えるプラグインを確認してから再開してください。"

#: includes/Admin/PasswordEmailPage.php:342
msgid "Some customers could not be read from the database, so the numbers below may be too low. Reload this page to count again."
msgstr "データベースから読めなかった顧客がいるため、下の件数は実際より少ない可能性があります。このページを再読み込みして数え直してください。"

#: includes/Admin/PasswordEmailPage.php:602
msgid "The customers could not be read from the database, so sending stopped instead of skipping them. Check the database, and then resume."
msgstr "データベースから顧客を読めなかったため、飛ばさずに送信を止めました。データベースを確認してから再開してください。"
