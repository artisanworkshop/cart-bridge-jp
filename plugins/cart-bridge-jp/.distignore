# Files in plugins/cart-bridge-jp/ that stay out of the plugin zip (bin/build-zip.sh rsyncs with this list).
# The development toolchain (composer, npm, phpcs, phpstan, CI, docs) lives at the repository root and is never copied.

# Admin UI sources (build/ output is kept)
src/

# Test suites
tests/
phpunit.xml.dist
.phpunit.result.cache

# Composer lock file. vendor/ is kept (the plugin autoloads via vendor/autoload.php at runtime), and so is composer.json:
# the WordPress.org Plugin Check warns (missing_composer_json_file) when vendor/ ships without it.
composer.lock

# Translations are not bundled: WordPress.org delivers them as language packs from translate.wordpress.org (issue #144).
# languages/ keeps the POT and the Japanese PO in the repository as the source to import there.
languages/

# WordPress.org directory assets (screenshots, banners, icons) go to the SVN assets/ directory, not the plugin zip
.wordpress-org/

# Misc
.distignore
.DS_Store
*.DS_Store
