# カラーミーショップ OAuthアプリの認証情報テンプレート。
# 実際の値を入れた colorme.env はコミットしないこと（.gitignore 済み）。
#
# 取得方法:
#   1. https://api.shop-pro.jp/developers/sign_up でデベロッパー登録
#   2. https://api.shop-pro.jp/oauth/applications/new でアプリ登録
#      リダイレクトURIには urn:ietf:wg:oauth:2.0:oob を指定する
#   3. アプリ詳細画面に表示される client_id / client_secret をコピー
CM_CLIENT_ID=
CM_CLIENT_SECRET=
CM_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
