{
  "name": "cart-bridge-jp",
  "private": true,
  "version": "0.1.0",
  "description": "Admin UI for Cart Bridge JP – Migrate for WooCommerce.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "wp-scripts start --source-path=src --output-path=build",
    "build": "wp-scripts build --source-path=src --output-path=build",
    "lint": "wp-scripts lint-js && tsc --noEmit",
    "test:js": "wp-scripts test-unit-js",
    "format": "wp-scripts format",
    "i18n:pot": "npm run build && bin/i18n.sh pot",
    "i18n:po": "bin/i18n.sh po",
    "i18n:compile": "bin/i18n.sh compile",
    "i18n:check": "npm run build && bin/i18n.sh check"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@wordpress/env": "^10.9.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.4.0",
    "@wordpress/components": "^28.4.0",
    "@wordpress/element": "^6.4.0",
    "@wordpress/i18n": "^5.4.0"
  },
  "overrides": {
    "fsevents": "2.3.2"
  }
}
