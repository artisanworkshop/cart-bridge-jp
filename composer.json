{
    "name": "artisanworkshop/cart-bridge-jp",
    "description": "Migrate products, customers, and orders between Japanese e-commerce platforms (Color Me Shop, MakeShop, BASE) and WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^8.9",
        "php-stubs/wordpress-stubs": "^6.5",
        "phpstan/phpstan-strict-rules": "^1.6",
        "yoast/phpunit-polyfills": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "CartBridgeJP\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CartBridgeJP\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.999"
        },
        "sort-packages": true
    }
}
