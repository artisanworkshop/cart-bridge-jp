includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    # 無料版だけを解析・走査する。無料版のコードが Pro（plugins/cart-bridge-jp-pro）を参照するとクラスが見つからず失敗する（D29: 依存は Pro から無料版への一方向）。
    paths:
        - plugins/cart-bridge-jp/includes
        - plugins/cart-bridge-jp/cart-bridge-jp.php
        - plugins/cart-bridge-jp/uninstall.php
    scanDirectories:
        - plugins/cart-bridge-jp/includes
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    ignoreErrors:
        # wp-config.php で定義されるランタイム定数のためスタブに存在しない。
        - '#Constant AUTH_(KEY|SALT) not found\.#'
        # cart-bridge-jp.php で define() されるプラグイン定数。ファイル横断のconst解決をphpstanが行えないため無視する。
        - '#Constant CBJP_(VERSION|FILE|PATH|URL) not found\.#'
