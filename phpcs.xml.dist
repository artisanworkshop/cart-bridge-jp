<?xml version="1.0"?>
<ruleset name="Cart Bridge JP">
	<description>WordPress Coding Standards for Cart Bridge JP.</description>

	<!-- 無料版と開発用の PHP（bin・.claude/skills。.claude/worktrees は Claude Code のワークツリーなので対象にしない）。Pro（plugins/cart-bridge-jp-pro）はテキストドメインが違うので、composer lint が
	     runtime-set で text_domain を cart-bridge-jp-pro にして plugins/cart-bridge-jp-pro だけを別に検査する（コマンドラインのファイル指定が file 要素より優先される）。 -->
	<file>plugins/cart-bridge-jp</file>
	<file>bin</file>
	<file>.claude/skills</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<!-- 手動検証用の使い捨てスクリプト（seed/verify/cleanup）。配布物ではなく（.distignore で除外）、echo や生の $wpdb を使うため WPCS の対象外にする。 -->
	<exclude-pattern>/.claude/skills/*/examples/*</exclude-pattern>
	<!-- リハーサル用の補助スクリプト（rehearse-colorme）。同じく配布物ではなく、echo・exit・生の $wpdb を使う。 -->
	<exclude-pattern>/.claude/skills/*/php/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra">
		<!-- includes/ 配下は PSR-4 のクラス名ファイル（ClassName.php）を使うため、WP標準の class-name.php 規約は適用しない。 -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- PHP 8.2+ 前提のため短縮配列構文を許可する。 -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- CLAUDE.md の規約でフィルター名は cbjp/{domain}/{action} 形式（スラッシュ区切り）と定めているため。 -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>

	<!-- 例外の文のエスケープ（R3-5b）。wordpress.org の申請で Plugin Check が ERROR にするので、プラグインのコードでは守る（式展開した文は
	     sprintf() と esc_html()、文でない引数・ASP や WP の HTTP API の文は理由つきの phpcs:ignore。CLAUDE.md）。テストと開発用（bin・.claude）は
	     配布物ではなく、bin/check-pro-zip.php は WP を読み込まずに動くので esc_html() を使えない。 -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<exclude-pattern>/bin/*</exclude-pattern>
		<exclude-pattern>/.claude/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cbjp_"/>
				<element value="CBJP_"/>
				<element value="CartBridgeJP"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<!-- WooCommerce が登録するcapability。WP core のsniffには未知として扱われるため明示する。 -->
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cart-bridge-jp"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_supported_wp_version" value="6.9"/>
</ruleset>
